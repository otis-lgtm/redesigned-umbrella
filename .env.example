# Stripe — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook signing secret — from Dashboard > Webhooks > your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — from Dashboard > Product catalog
STRIPE_PRICE_ID_ONCE=price_...
STRIPE_PRICE_ID_SUB=price_...

# Your deployed Vercel URL (no trailing slash)
APP_URL=https://your-app.vercel.app

# Vercel KV — auto-injected when you connect a KV database in Vercel Dashboard
KV_REST_API_URL=
KV_REST_API_TOKEN=
